# Copy to `.env` and fill in. Never commit `.env` (it is gitignored). In GitHub Actions, add each as a repository secret.

# Required: Metaculus bot account token (CrystalBallMcGee-bot). https://www.metaculus.com/futureeval/participate/
METACULUS_TOKEN=REPLACE_ME

# Required: OpenRouter key for the forecasters (ADR-0003). https://openrouter.ai/keys
OPENROUTER_API_KEY=REPLACE_ME

# Research (optional but needed to publish: the bot refuses to publish without research).
# Gemini grounded search, free quota: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=REPLACE_ME
# AskNews (Metaculus bot grant): latest-news search, 1 call per question.
# ASKNEWS_CLIENT_ID=REPLACE_ME
# ASKNEWS_SECRET=REPLACE_ME
# or instead an API key:
# ASKNEWS_API_KEY=REPLACE_ME
